from collections.abc import Iterable, Iterator, Sequence
from typing import Any, ClassVar, overload

class GlyphRanges(metaclass=_pybind11_type):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, other: GlyphRanges) -> None: ...
    @overload
    def __init__(self, iterable: Iterable[int]) -> None: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __contains__(self, x: int) -> bool: ...
    def __iter__(self) -> Iterator[int]: ...
    @overload
    def __getitem__(self, i: int) -> int: ...
    @overload
    def __getitem__(self, s: slice) -> GlyphRanges: ...
    @overload
    def __setitem__(self, i: int, x: int) -> None: ...
    @overload
    def __setitem__(self, s: slice, value: GlyphRanges) -> None: ...
    @overload
    def __delitem__(self, i: int) -> None: ...
    @overload
    def __delitem__(self, s: slice) -> None: ...
    def append(self, x: int) -> None: ...
    def clear(self) -> None: ...
    def count(self, x: int) -> int: ...
    @overload
    def extend(self, L: GlyphRanges) -> None: ...
    @overload
    def extend(self, L: Iterable[int]) -> None: ...
    def insert(self, i: int, x: int) -> None: ...
    @overload
    def pop(self) -> int: ...
    @overload
    def pop(self, i: int) -> int: ...
    def remove(self, x: int) -> None: ...

