#
# Counting: a proposal per step, and a boot rule
#

predicate countTo(int)
predicate value(int)


context CountingContext
    /countTo 5
        value 0


expert Counting(Deliberator)

    # `start` is raised once, after the starting context is in place.
    def Setup(start)
        | print("counting in sub-contexts")

    def Impasse(impasse)
        where
            Goal $g status Active
            -->
            * $g
            !==>
            halt

    def IncrementPropose(/countTo $v1 -> $g)
        where
            $g value $v1
            -->
            succeed
            !==>
            * /increment $g
            return

    def IncrementApply(/increment $g)
        where
            $g value $v1
            -->
            -+ $g value {$v1 + 1}
            || print($v1 + 1, "...")
