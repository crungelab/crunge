#
# Sibling Query
#

class Person
class Family

agent SiblingAgent

    predicate family(Family)
    predicate spouse(Person)
    predicate child(Person)
    predicate parent(Person)
    predicate sibling(Person)

    def SiblingAgent(/siblingAgent)

        context FamilyContext

            Family Smith

            Person Mary
                family Smith
                spouse John
                child Billy
                child Suzy

            Person John
                family Smith
                spouse Mary
                child Billy
                child Suzy

            Person Billy
                family Smith
                parent John
                parent Mary

            Person Suzy
                family Smith
                parent John
                parent Mary

        /siblings context: FamilyContext


    expert Siblings

        def Siblings(/siblings)
            /findSibling Billy

        def SiblingFinder(/findSibling $x)
            where
                $x parent $p
                $y parent $p
                $y != $x
                -->
                + $x sibling $y
                | print(f"{$x} and {$y} are siblings")
                ==>
                halt
