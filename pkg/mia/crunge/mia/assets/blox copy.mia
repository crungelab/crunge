#
# Blocks World
#

class Table
class Block

agent BloxAgent

    predicate isClear(bool)

    def BloxAgent(/bloxAgent)

        context BloxContext

            Table Table1 isClear True

            Block Block1 onTop Table1

            Block Block2 onTop Block1

            Block Block3
                onTop Block2
                isClear True

            /stack Block1 on: Block2

            /stack Block2 on: Block3

        /blox context: BloxContext


    expert Blox

        def Blox(/blox)
            pass

        def Impasse(impasse)
            where
                Goal $g status Active
                -->
                * $g
                !==>
                halt

        def GoalElab(+ Goal $g)
            + $g status Active

        def NotGoalElab(- Goal $g)
            - $g status Active

        def Stack(/stack $x on: $y -> $g)
            where
                not $x isClear True
                -->
                /clear $x
                ==>
                return

            where
                not $y isClear True
                -->
                /clear $y
                ==>
                return

            where
                $x onTop $z
                -->
                - $x onTop $z

            + $x onTop $y

            - $g

        def Clear(/clear $x)
            where
                $x beneath $y
                $z isClear True
                $z != $x
                $z != $y
                -->
                * /stack $y on: $z

        def NotOnTopElab(- $x onTop $y)
            - $y beneath $x
            + $y isClear True

        def OntopElab(+ $x onTop $y)
            where
                Block $y isClear True
                -->
                - $y isClear True

            where
                $x onTop $y
                -->
                + $y beneath $x